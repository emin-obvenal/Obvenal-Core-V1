    {
      "parameters": {
        "jsCode": "const currentBooking = $json;\nconst checkIn = new Date(currentBooking.check_in);\nconst checkOut = new Date(currentBooking.check_out);\nconst villa = currentBooking.villa;\n\n// Tüm mock data'yı al\nconst allBookings = $('MockBookingData').all();\n\nconst hasConflict = allBookings.some(booking => {\n  // Kendisiyle karşılaştırma\n  if (booking.json.booking_id === currentBooking.booking_id) return false;\n  \n  // Farklı villa ise çakışma yok\n  if (booking.json.villa !== villa) return false;\n  \n  // İptal veya maintenance ise çakışma yok\n  if (['cancelled', 'maintenance'].includes(booking.json.status)) return false;\n  \n  const bStart = new Date(booking.json.check_in);\n  const bEnd = new Date(booking.json.check_out);\n  \n  return checkIn < bEnd && checkOut > bStart;\n});\n\nreturn [{ json: { ...currentBooking, has_conflict: hasConflict } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
